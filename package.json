{
  "name": "@geomatico/maplibre-cog-reproject",
  "version": "0.1.0",
  "description": "Reprojection of COGs that are not in Web Mercator, for @geomatico/maplibre-cog-protocol",
  "scripts": {
    "watch:src": "rimraf dist && rollup -c rollup.config.mjs --environment DEV --watch",
    "watch:examples": "five-server",
    "watch": "concurrently --names 'SRC,EXAMPLES' --prefix-colors 'yellow,blue' --kill-others 'npm run watch:src' 'npm run watch:examples'",
    "lint": "biome check --write src/",
    "test": "npm run lint && vitest run --reporter=default --reporter=junit --outputFile=junit.xml --coverage",
    "build:umd": "rollup -c rollup.config.mjs",
    "build:esm": "tsc --outDir dist/esm",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "build:site": "node scripts/build-site.mjs",
    "build": "rimraf dist && concurrently --names 'UMD,ESM,TYPES' 'npm run build:umd' 'npm run build:esm' 'npm run build:types'",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "author": "Geomatico <info@geomatico.es>",
  "dependencies": {
    "@developmentseed/raster-reproject": "^0.8.1",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@geomatico/maplibre-cog-protocol": "github:geoawd/maplibre-cog-protocol#hook-build",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.0",
    "five-server": "^0.5.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.27.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0"
  },
  "peerDependencies": {
    "@geomatico/maplibre-cog-protocol": "*"
  }
}
